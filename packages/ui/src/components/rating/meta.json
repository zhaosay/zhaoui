{
  "name": "rating",
  "title": "评分",
  "summary": "星形或心形评分，支持半星、只读、清除、文字标签。交互版本是一组 radio，键盘与读屏都可用。",
  "classes": [
    "zh-rating"
  ],
  "attributes": [
    {
      "name": "data-value",
      "on": ".zh-rating",
      "value": "数字",
      "desc": "当前评分；只读时可以是小数（如 4.27），会按比例填充"
    },
    {
      "name": "data-count",
      "on": ".zh-rating",
      "value": "整数，默认 5",
      "desc": "总数"
    },
    {
      "name": "data-half",
      "on": ".zh-rating",
      "value": "布尔属性",
      "desc": "允许半星"
    },
    {
      "name": "data-readonly / data-disabled",
      "on": ".zh-rating",
      "value": "布尔属性",
      "desc": "只读展示 / 禁用"
    },
    {
      "name": "data-clear",
      "on": ".zh-rating",
      "value": "布尔属性",
      "desc": "再次点击同一个分数、或按 Delete / Backspace 清除评分"
    },
    {
      "name": "data-icon",
      "on": ".zh-rating",
      "value": "star（默认）| heart",
      "desc": "图标"
    },
    {
      "name": "data-labels",
      "on": ".zh-rating",
      "value": "逗号分隔的文字，如 很差,较差,一般,满意,很好",
      "desc": "每一档的文字，选中时显示在旁边"
    },
    {
      "name": "data-show-value",
      "on": ".zh-rating",
      "value": "布尔属性",
      "desc": "在旁边显示数字"
    },
    {
      "name": "data-label",
      "on": ".zh-rating",
      "value": "字符串",
      "desc": "无障碍名称，默认「评分」"
    }
  ],
  "events": [
    {
      "name": "zh:rating",
      "on": ".zh-rating",
      "detail": "{ value }",
      "desc": "评分变化时触发（冒泡）"
    }
  ],
  "methods": [
    {
      "name": "el.zhRating.get()",
      "desc": "读取当前评分"
    }
  ],
  "a11y": [
    "交互评分是 radiogroup，每个分值一个 radio，方向键切换，带「3 星 · 一般」形式的 aria-label",
    "只读评分是 role=\"img\"，读作「综合评分 4.3 分，满分 5 分」",
    "悬停时预览分数，移开后还原"
  ],
  "example": "<div class=\"zh-rating\" id=\"rt\" data-value=\"3\" data-label=\"服务评分\" data-labels=\"很差,较差,一般,满意,很好\"></div>\n<div class=\"zh-rating\" data-value=\"3.5\" data-half data-show-value data-label=\"口味评分\"></div>\n<div class=\"zh-rating\" data-readonly data-value=\"4.27\" data-show-value data-label=\"综合评分\"></div>\n\n<script>\ndocument.getElementById('rt').addEventListener('zh:rating', function (e) {\n  console.log(e.detail.value);\n});\n</script>"
}
