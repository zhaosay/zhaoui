{
  "name": "zhaoui",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @zhaoui/tokens && npm run build -w @zhaoui/ui",
    "test": "npm test -w @zhaoui/tokens",
    "demo": "node demo/build.mjs",
    "test:ui": "npm test -w @zhaoui/ui",
    "site": "node site/build.mjs",
    "site:dev": "node site/serve.mjs",
    "site:all": "npm run build && node site/build.mjs",
    "test:site": "node site/test/site.mjs",
    "test:setup": "playwright install chromium firefox webkit",
    "test:install": "node site/test/install.mjs",
    "test:all": "npm run build && npm test && npm run test:ui && npm run test:matrix -w @zhaoui/ui && npm run site && npm run test:site && npm run test:install",
    "check:release": "node site/scripts/check-release.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright": "1.62.0",
    "pngjs": "^7.0.0"
  }
}
